---
/**
 * Starlight `Hero` override for the landing page.
 * Renders the standard title/tagline/actions plus a "latest digest" panel
 * driven entirely by data/latest.json — skills update that JSON, never this file.
 */
import SourceBadge from './SourceBadge.astro';
import type { Category } from './SourceBadge.astro';
import { withBase } from '../lib/url';
import latest from '../../data/latest.json';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const latestDate = latest.date
	? new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' }).format(
			new Date(latest.date)
		)
	: null;
---

<div class="hero">
	<div class="stack">
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <div class="tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ link, text, variant }) => (
						<a href={link} class:list={['action', variant ?? 'primary']}>
							{text}
						</a>
					))}
				</div>
			)
		}
	</div>

	{
		latest.topStory && latestDate && (
			<aside class="latest-panel">
				<p class="panel-label">Latest digest · {latestDate}</p>
				<div class="top-story">
					<SourceBadge category={latest.topStory.category as Category} />
					<h2>
						<a href={withBase(latest.pagePath)}>{latest.topStory.title}</a>
					</h2>
					<p>{latest.topStory.whyItMatters}</p>
				</div>
				<p class="stats">
					{latest.stats.selected} stories selected from {latest.stats.candidates} candidates
				</p>
				<div class="panel-actions">
					<a class="action primary" href={withBase(latest.pagePath)}>
						Read the digest
					</a>
					{latest.weekly && (
						<a class="action minimal" href={withBase(latest.weekly.pagePath)}>
							Weekly recap {latest.weekly.week}
						</a>
					)}
				</div>
			</aside>
		)
	}
</div>

<style>
	.hero {
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 2rem;
		padding-block: clamp(1.5rem, calc(1rem + 4vmin), 4rem) 1rem;
	}
	.stack {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		text-align: center;
	}
	h1 {
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 4.5vw), var(--sl-text-6xl));
		line-height: var(--sl-line-height-headings);
		font-weight: 650;
		color: var(--sl-color-white);
		letter-spacing: -0.02em;
	}
	.tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 1.6vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
		max-width: 46ch;
		margin-inline: auto;
	}
	.actions,
	.panel-actions {
		display: flex;
		gap: 0.75rem 1.25rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.action {
		display: inline-block;
		border-radius: 999px;
		padding: 0.55em 1.2em;
		font-weight: 600;
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	.action.primary {
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.action.primary:hover {
		background: var(--sl-color-accent-high);
	}
	.action.minimal {
		color: var(--sl-color-accent-high);
		border: 1px solid var(--sl-color-accent);
	}
	.latest-panel {
		border: 1px solid var(--card-border);
		border-radius: 1rem;
		background: var(--card-bg);
		padding: 1.4rem 1.5rem;
		text-align: start;
	}
	.panel-label {
		font-size: var(--sl-text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--sl-color-gray-3);
		margin: 0 0 0.75rem;
	}
	.top-story h2 {
		font-size: var(--sl-text-xl);
		line-height: 1.3;
		margin: 0.5rem 0 0;
	}
	.top-story h2 a {
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.top-story h2 a:hover {
		color: var(--sl-color-accent-high);
	}
	.top-story p {
		margin: 0.6rem 0 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	.stats {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		margin: 0.9rem 0;
	}
	.panel-actions {
		justify-content: flex-start;
	}

	@media (min-width: 50rem) {
		.hero {
			grid-template-columns: 6fr 5fr;
			gap: 4%;
			padding-block: clamp(2.5rem, calc(1rem + 8vmin), 8rem) 2rem;
		}
		.stack {
			text-align: start;
		}
		.tagline {
			margin-inline: 0;
		}
		.actions {
			justify-content: flex-start;
		}
	}
</style>
